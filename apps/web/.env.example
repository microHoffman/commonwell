# Copy to apps/web/.env. Everything here is public: it ends up in the built site.

# Which deployments/<name>.json the site reads, comma-separated, one per chain (the first is the default
# chain): hoodi-dev while developing, hoodi for the shared demo.
NUXT_PUBLIC_DEPLOYMENTS=hoodi-dev

# Client ID of your MetaMask Embedded Wallets (Web3Auth) project, Sapphire Devnet, from developer.metamask.io.
# Allowlist http://localhost:3000 and the Cloudflare Pages domain in the project.
NUXT_PUBLIC_WEB3_AUTH_CLIENT_ID=

# Optional: RPCs for the browser per chain ID, instead of the deployments' rpcUrls.
# NUXT_PUBLIC_RPC_URLS=560048=https://rpc-a,https://rpc-b;1=https://rpc-c
