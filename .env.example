# Script settings. `bun run keys` creates .env.local with the testnet-only keys; add these there as needed.

# Your wallet(s) as curators, comma-separated. Read by deploy:core.
CURATOR_ADDRESSES=

# Optional: comma-separated RPCs per chain ID, instead of the deployment's (or scripts/networks.ts's) public ones.
# RPC_URLS_560048=
# RPC_URLS_1=

# Optional: seed deposit per community in ETH (default 0.01).
# SEED_AMOUNT=0.1

# Any NAME_KEY can come from a Foundry keystore instead (`cast wallet import <name> --interactive`):
# set NAME_KEYSTORE=<name>, and the scripts ask for its password. Required off testnets.
# DEPLOYER_KEYSTORE=
# Optional: CAST_UNSAFE_PASSWORD skips the prompt; KEYSTORE_DIR overrides ~/.foundry/keystores.

# Optional: key that pays for `bun run payout` (defaults to DEPLOYER_KEY).
# PAYOUT_KEY=

# Optional: verifies each vault type's shared contracts on the chain's Etherscan during deploy:core.
# ETHERSCAN_API_KEY=

# Optional: archive RPC for the Foundry fork tests (default https://rpc.hoodi.ethpandaops.io).
# HOODI_ARCHIVE_RPC_URL=
